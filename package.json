{
  "name": "checador-lse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Checador de Legendagem para Surdos e Ensurdecidos (LSE) — validador, revisor assistido e exportador, client-side.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p desktop",
    "build:desktop": "tsc -p desktop/tsconfig.json && node desktop/build.mjs",
    "desktop": "npm run build && npm run build:desktop && electron .",
    "desktop:dev": "npm run build:desktop && electron . --dev-server=http://localhost:5173"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@tanstack/react-virtual": "^3.14.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "axe-core": "^4.14.0",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "main": "dist-desktop/main.cjs"
}
